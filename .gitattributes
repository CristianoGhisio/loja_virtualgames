# Force LF line endings for shell scripts
*.sh text eol=lf

# Force LF for Dockerfile
Dockerfile text eol=lf

# Force LF for entrypoint
scripts/entrypoint.prod.sh text eol=lf

# Keep LF for all text files
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.md text eol=lf
*.mjs text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
