# =============================================================================
# AMBIENTE DE PRODUÇÃO — Loja (Hostinger VPS)
# =============================================================================
# Domínio: virtualgames.com.br
# Porta interna do app: 3002 → 3000 (container)
# =============================================================================

# ---- PostgreSQL (Container) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=loja_vps_db

# ---- Database Connection (App) ----
# O host "postgres" é o nome do serviço no docker-compose (rede interna Docker)
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---- Next.js / Node ----
NODE_ENV=production

# ---- NextAuth v5 ----
AUTH_SECRET=use-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# ---- URLs da Aplicação ----
NEXTAUTH_URL=https://virtualgames.com.br
NEXT_PUBLIC_SITE_URL=https://virtualgames.com.br
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://loja_vps_app:3000

# ---- OS Approval Secret ----
# Chave secreta para assinatura de aprovação de OS (via link público)
OS_APPROVAL_SECRET=change-me-in-production

# ---- Cosmos (API de consulta de produtos por GTIN) ----
# Usado em: /api/integrations/cosmos/import-by-barcode
# Sem essas variáveis, a importação de produtos por código de barras NÃO funciona.
COSMOS_BASE_URL=https://api.cosmos.bluesoft.com.br
COSMOS_TOKEN=change-me-in-production
COSMOS_USER_AGENT=Cosmos-API-Request
COSMOS_TIMEOUT_MS=8000

# ---- WhatsApp Bot ----
# Usado em: atendimento, envio de recibos, importação de leads via webhook
# Sem essas variáveis, o bot do WhatsApp NÃO funciona.
WHATSAPP_BOT_TOKEN=change-me-in-production
WHATSAPP_BOT_BASE_URL=http://127.0.0.1:3333
WHATSAPP_BOT_URL=http://127.0.0.1:3333/send
WHATSAPP_BOT_PORT=3333
