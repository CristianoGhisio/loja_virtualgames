generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailVerified DateTime?
  image         String?
  password      String?
  roleId        String
  lockedUntil   DateTime?
  failedLoginAttempts Int      @default(0)
  accounts      Account[]
  logs          AuditLog[]
  serviceOrders ServiceOrder[]
  sessions      Session[]
  employees     Employee[]
  role          Role           @relation(fields: [roleId], references: [id])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  action      String
  resource    String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([action, resource])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id             String                @id @default(cuid())
  name           String
  email          String?               @unique
  document       String                @unique
  type           CustomerType          @default(PF)
  phone          String?
  zipCode        String?
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  interactions   CustomerInteraction[]
  funnelCards    CustomerFunnelCard[]
  productsOrigin Product[]             @relation("ProductOrigin")
  receivables    Receivable[]
  sales          Sale[]
  returns        SaleReturn[]
  serviceOrders  ServiceOrder[]
}

model CustomerInteraction {
  id         String   @id @default(cuid())
  customerId String
  type       String
  content    String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerFunnelCard {
  id               String       @id @default(cuid())
  customerId       String
  stage            FunnelStage  @default(NOVO_CONTATO)
  sellerNote       String?
  itemInterest     String?
  active           Boolean      @default(true)
  hasNewMessage    Boolean      @default(false)
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lastStageChangeAt DateTime    @default(now())
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, active])
  @@index([stage, active])
}

model Supplier {
  id           String                @id @default(cuid())
  name         String
  contact      String?
  phone        String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  document     String?               @unique
  email        String?
  payables     Payable[]
  products     Product[]
  interactions SupplierInteraction[]
}

model SupplierInteraction {
  id         String   @id @default(cuid())
  supplierId String
  type       String
  content    String
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Category {
  id            String        @id @default(cuid())
  name          String
  description   String?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  slug          String        @unique
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id            String         @id @default(cuid())
  categoryId    String
  name          String
  slug          String?
  description   String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  manufacturers Manufacturer[] @relation("ManufacturerToSubcategory")

  @@unique([slug, categoryId])
  @@index([categoryId])
}

model Manufacturer {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  website       String?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  products      Product[]
  subcategories Subcategory[] @relation("ManufacturerToSubcategory")
}

model Product {
  id                  String                @id @default(cuid())
  price               Decimal               @db.Decimal(10, 2)
  barcode             String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  active              Boolean               @default(true)
  condition           ProductCondition      @default(NEW)
  categoryId          String
  manufacturerId      String
  originClientId      String?
  supplierId          String?
  type                ProductType           @default(PRODUCT)
  ncm                 String?
  unit                String?               @default("UN")
  allowUsed           Boolean               @default(true)
  baseSku             String?               @unique
  commercialName      String
  commission          Decimal               @default(0) @db.Decimal(10, 2)
  controlSerialNumber Boolean               @default(false)
  height              Decimal?              @db.Decimal(10, 2)
  length              Decimal?              @db.Decimal(10, 2)
  location            String?
  longDescription     String?
  margin              Decimal               @default(0) @db.Decimal(5, 2)
  shortDescription    String?
  warrantyMonths      Int?
  weight              Decimal?              @db.Decimal(10, 3)
  width               Decimal?              @db.Decimal(10, 2)
  items               Item[]
  listings            MarketplaceListing[]
  category            Category              @relation(fields: [categoryId], references: [id])
  manufacturer        Manufacturer          @relation(fields: [manufacturerId], references: [id])
  originClient        Customer?             @relation("ProductOrigin", fields: [originClientId], references: [id])
  supplier            Supplier?             @relation(fields: [supplierId], references: [id])
  attributes          ProductAttribute[]
  priceHistory        ProductPriceHistory[]
  variations          ProductVariation[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  osItems             ServiceOrderItem[]
  stock               Stock?
  stockMovements      StockMovement[]

  @@index([baseSku])
  @@index([barcode])
  @@index([categoryId])
  @@index([manufacturerId])
}

model ProductVariation {
  id        String               @id @default(cuid())
  productId String
  sku       String               @unique
  title     String
  basePrice Decimal              @db.Decimal(10, 2)
  active    Boolean              @default(true)
  listings  MarketplaceListing[]
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sku])
}

model Attribute {
  id                  String                @id @default(cuid())
  name                String
  slug                String                @unique
  type                AttributeType         @default(TEXT)
  marketplaceRequired Boolean               @default(false)
  order               Int                   @default(0)
  createdAt           DateTime              @default(now())
  entitySource        AttributeEntitySource @default(NONE)
  options             AttributeOption[]
  productAttributes   ProductAttribute[]
}

model AttributeOption {
  id          String    @id @default(cuid())
  attributeId String
  value       String
  label       String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([attributeId])
}

model ProductAttribute {
  id          String    @id @default(cuid())
  productId   String
  attributeId String
  value       String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
}

model Stock {
  id          String   @id @default(cuid())
  productId   String   @unique
  quantity    Int      @default(0)
  averageCost Decimal  @default(0) @db.Decimal(10, 2)
  totalValue  Decimal  @default(0) @db.Decimal(10, 2)
  minStock    Int      @default(5)
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Item {
  id           String           @id @default(cuid())
  productId    String
  serialNumber String           @unique
  imei         String?
  condition    ProductCondition
  grade        String?
  costPrice    Decimal          @db.Decimal(10, 2)
  warrantyDays Int?
  status       ItemStatus       @default(AVAILABLE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Decimal  @db.Decimal(10, 2)
  newPrice  Decimal  @db.Decimal(10, 2)
  changedBy String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Service {
  id                       String             @id @default(cuid())
  name                     String
  active                   Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  commissionType           CommissionType     @default(PERCENT)
  commissionValue          Decimal            @default(0) @db.Decimal(10, 2)
  descriptionShort         String?
  estimatedTimeMin         Int?
  internalCode             String             @unique
  marketplaceCategoryId    String?
  marketplaceDescTemplate  String?
  marketplaceTitleTemplate String?
  priceBase                Decimal            @db.Decimal(10, 2)
  priceType                ServicePriceType   @default(FIXED)
  warrantyMonths           Int?
  osItems                  ServiceOrderItem[]
}

model StockMovement {
  id                   String            @id @default(cuid())
  quantity             Int
  productId            String
  createdAt            DateTime          @default(now())
  createdBy            String?
  reason               String?
  referenceId          String?
  type                 StockMovementType
  invoice              String?
  resultingAverageCost Decimal?          @db.Decimal(10, 2)
  supplierId           String?
  unitCost             Decimal?          @db.Decimal(10, 2)
  product              Product           @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Sale {
  id            String      @id @default(cuid())
  date          DateTime    @default(now())
  total         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String?
  customerId    String?
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  installments  Int         @default(1)
  paymentMethod String
  status        SaleStatus  @default(COMPLETED)
  receivable    Receivable?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  returns       SaleReturn[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  costPrice Decimal @db.Decimal(10, 2)
  warrantyMonths Int?
  total     Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model SaleReturn {
  id         String           @id @default(cuid())
  saleId     String
  customerId String?
  reason     String
  notes      String?
  status     ReturnStatus     @default(PENDING)
  type       ReturnType       @default(RETURN)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  createdBy  String?
  sale       Sale             @relation(fields: [saleId], references: [id])
  customer   Customer?        @relation(fields: [customerId], references: [id])
  items      SaleReturnItem[]
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  productId    String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(10, 2)
  reason       String?
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])
}

model ServiceOrder {
  id            String                @id @default(cuid())
  device        String
  serial        String?
  defect        String
  entryDate     DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  customerId    String
  discount      Decimal               @default(0) @db.Decimal(10, 2)
  endDate       DateTime?
  notes         String?
  report        String?
  technicianId  String?
  total         Decimal               @default(0) @db.Decimal(10, 2)
  totalParts    Decimal               @default(0) @db.Decimal(10, 2)
  totalServices Decimal               @default(0) @db.Decimal(10, 2)
  status        OSStatus              @default(ENTRADA)
  priority      OSPriority            @default(NORMAL)
  receivable    Receivable?
  customer      Customer              @relation(fields: [customerId], references: [id])
  technician    User?                 @relation(fields: [technicianId], references: [id])
  history       ServiceOrderHistory[]
  items         ServiceOrderItem[]
}

model ServiceOrderItem {
  id             String        @id @default(cuid())
  serviceOrderId String
  type           OrderItemType
  productId      String?
  serviceId      String?
  name           String
  quantity       Int           @default(1)
  unitPrice      Decimal       @db.Decimal(10, 2)
  costPrice      Decimal       @default(0) @db.Decimal(10, 2)
  warrantyMonths Int?
  total          Decimal       @db.Decimal(10, 2)
  product        Product?      @relation(fields: [productId], references: [id])
  service        Service?      @relation(fields: [serviceId], references: [id])
  serviceOrder   ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
}

model ServiceOrderHistory {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  notes          String?
  serviceOrderId String
  userId         String?
  status         OSStatus
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
}

model CostCenter {
  id          String         @id @default(cuid())
  name        String
  type        CostCenterType
  active      Boolean        @default(true)
  payables    Payable[]
  receivables Receivable[]
}

model Receivable {
  id             String         @id @default(cuid())
  description    String
  origin         ReceivableOrigin @default(MANUAL)
  dueDate        DateTime
  value          Decimal        @db.Decimal(10, 2)
  paymentMethod  String?
  cardFeePercent Decimal?       @db.Decimal(5, 2)
  cardFeeValue   Decimal?       @db.Decimal(10, 2)
  netValue       Decimal?       @db.Decimal(10, 2)
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  costCenterId   String?
  customerId     String?
  saleId         String?        @unique
  serviceOrderId String?        @unique
  status         PaymentStatus  @default(PENDING)
  movements      CashMovement[]
  costCenter     CostCenter?    @relation(fields: [costCenterId], references: [id])
  customer       Customer?      @relation(fields: [customerId], references: [id])
  sale           Sale?          @relation(fields: [saleId], references: [id])
  serviceOrder   ServiceOrder?  @relation(fields: [serviceOrderId], references: [id])

  @@index([origin, paidAt])
}

model Payable {
  id           String         @id @default(cuid())
  description  String
  payableType  PayableType    @default(DEFAULT)
  technicianUserId String?
  competenceMonth Int?
  competenceYear Int?
  dueDate      DateTime
  value        Decimal        @db.Decimal(10, 2)
  attachmentUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  costCenterId String?
  supplierId   String?
  status       PaymentStatus  @default(PENDING)
  movements    CashMovement[]
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id])
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
}

model ServiceCommissionProvision {
  id               String                   @id @default(cuid())
  serviceOrderId   String
  serviceOrderItemId String
  serviceId        String?
  technicianUserId String
  competenceMonth  Int
  competenceYear   Int
  baseAmount       Decimal                  @db.Decimal(10, 2)
  commissionPercent Decimal                 @db.Decimal(5, 2)
  commissionAmount Decimal                  @db.Decimal(10, 2)
  status           ServiceCommissionStatus  @default(PROVISIONED)
  paidAt           DateTime?
  payableId        String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([serviceOrderItemId, technicianUserId])
  @@index([technicianUserId, competenceYear, competenceMonth, status])
  @@index([status, paidAt])
}

model CashMovement {
  id           String           @id @default(cuid())
  date         DateTime         @default(now())
  createdAt    DateTime         @default(now())
  description  String?
  payableId    String?
  receivableId String?
  type         CashMovementType
  userId       String?
  value        Decimal          @db.Decimal(10, 2)
  payable      Payable?         @relation(fields: [payableId], references: [id])
  receivable   Receivable?      @relation(fields: [receivableId], references: [id])
}

model DailyMetrics {
  id           String   @id @default(cuid())
  date         DateTime @unique @db.Date
  totalSales   Decimal  @default(0) @db.Decimal(10, 2)
  totalCost    Decimal  @default(0) @db.Decimal(10, 2)
  totalRevenue Decimal  @default(0) @db.Decimal(10, 2)
  osCount      Int      @default(0)
  saleCount    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model PaymentFeeSettings {
  id                String   @id @default(cuid())
  creditFixedFee    Decimal  @default(0) @db.Decimal(10, 2)
  creditVariableFee Decimal  @default(0) @db.Decimal(5, 2)
  debitFixedFee     Decimal  @default(0) @db.Decimal(10, 2)
  debitVariableFee  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StoreSettings {
  id           String   @id @default(cuid())
  nameFantasia String   @default("Virtual Games")
  cnpj         String   @default("00.000.000/0001-00")
  address      String   @default("Rua Venâncio Aires, 1434, Torre Divindade. Sala 106 D-2, Centro, Santa Maria, RS - CEP 97010-002")
  phone        String   @default("(55) 99725-2786")
  email        String   @default("contato@virtualgames.com")
  serviceHours String   @default("Segunda a Sexta: 09:00 às 18:30 | Sábado: 09:00 às 13:00")
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  module    String
  entity    String
  entityId  String
  ip        String?
  createdAt DateTime @default(now())
  userId    String?
  newValue  String?
  oldValue  String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Marketplace {
  id         String                @id @default(cuid())
  name       String                @unique
  apiCode    String?
  active     Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  categories MarketplaceCategory[]
  listings   MarketplaceListing[]
}

model MarketplaceCategory {
  id            String      @id @default(cuid())
  marketplaceId String
  externalCode  String
  externalName  String
  categoryId    String?
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@unique([marketplaceId, externalCode])
  @@index([categoryId])
}

model MarketplaceListing {
  id             String            @id @default(cuid())
  marketplaceId  String
  productId      String
  variationId    String?
  externalId     String?
  publishedTitle String?
  publishedPrice Decimal?          @db.Decimal(10, 2)
  status         String?           @default("DRAFT")
  publicLink     String?
  syncStock      Boolean           @default(true)
  syncPrice      Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  marketplace    Marketplace       @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation      ProductVariation? @relation(fields: [variationId], references: [id])

  @@unique([marketplaceId, productId, variationId])
  @@index([externalId])
}

enum CustomerType {
  PF
  PJ
}

enum AttributeEntitySource {
  NONE
  MANUFACTURER
  SUPPLIER
  CATEGORY
}

enum AttributeType {
  TEXT
  NUMBER
  LIST
  BOOLEAN
}

enum ItemStatus {
  AVAILABLE
  SOLD
  MAINTENANCE
  RESERVED
}

enum ProductType {
  PRODUCT
  PART
  SERVICE
}

enum ProductCondition {
  NEW
  USED
  DEFECTIVE
}

enum ServicePriceType {
  FIXED
  HOURLY
  VARIABLE
}

enum CommissionType {
  PERCENT
  FIXED
}

enum StockMovementType {
  IN_PURCHASE
  IN_RETURN
  IN_ADJUSTMENT
  OUT_SALE
  OUT_WARRANTY
  OUT_LOSS
  OUT_ADJUSTMENT
  OUT_SERVICE_PART
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum FunnelStage {
  NOVO_CONTATO
  EM_ANDAMENTO
  CONTATO_QUENTE
  DESINTERESSADO
  VENDA_CONCLUIDA
  FEEDBACK_REALIZADO
  FINALIZADO
}

enum OSStatus {
  ENTRADA
  DIAGNOSTICO
  ORCAMENTO
  AGUARDANDO_APROVACAO
  APROVADO
  EM_REPARO
  AGUARDANDO_PECA
  FINALIZADO
  ENTREGUE
  CANCELADO
}

enum OSPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrderItemType {
  PART
  SERVICE
}

enum CostCenterType {
  REVENUE
  EXPENSE
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  OVERDUE
}

enum ReceivableOrigin {
  MANUAL
  SALE
  SERVICE
}

enum PayableType {
  DEFAULT
  TECHNICIAN_COMMISSION
}

enum ServiceCommissionStatus {
  PROVISIONED
  PAID
  CANCELLED
}

enum CashMovementType {
  IN
  OUT
}

model Employee {
  id                 String               @id @default(cuid())
  nomeCompleto       String
  cpf                String               @unique
  dataNascimento     DateTime
  celularWhatsapp    String
  emailPessoal       String?
  dataAdmissao       DateTime
  cargoFuncao        String
  tipoContrato       EmployeeContractType
  salarioBase        Decimal              @db.Decimal(10, 2)
  percentualComissao Decimal?             @db.Decimal(5, 2)
  chavePix           String?
  status             EmployeeStatus       @default(ATIVO)
  userId             String?
  
  fotoUrl            String?
  descricaoPerfil    String?              @db.Text
  
  user               User?                @relation(fields: [userId], references: [id])
  
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

enum EmployeeContractType {
  CLT
  PJ
  AUTONOMO
  ESTAGIARIO
  SOCIO
}

enum EmployeeStatus {
  ATIVO
  INATIVO
}
